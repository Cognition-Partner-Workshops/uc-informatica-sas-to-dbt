/*=====================================================================
  tools/sas_golden/run_golden.sas - golden-output driver for a licensed
  SAS 9.4 M5+ host. Runs every scenario in tests/golden/*/scenarios.json
  (via the generated tools/sas_golden/golden_plan.sas) against the
  UNMODIFIED programs in legacy/sas/programs and writes
      tests/golden/<kit>/scenarios/<id>/golden/<TARGET>.csv
  plus golden/_status.txt (target existence, row counts, SYSCC).

  Run in batch mode (batch syntax-check semantics are part of several
  expected outcomes), one SAS session per scenario is recommended:
      GOLDEN_REPO=/path/to/repo sas -nodms -noautoexec \
          -sysin tools/sas_golden/run_golden.sas \
          -sysparm "claims_processing:S01_core_rules"
  -sysparm "<program>" runs every scenario of one program, and an empty
  -sysparm runs all 94 scenarios in one session.

  Environment variables (read with %sysget):
    GOLDEN_REPO         repo root (required)
    GOLDEN_SAS_ROOT     default /opt/sas/custom. The programs %include
                        "/opt/sas/custom/macros/<m>.sas" by absolute path,
                        so this must be /opt/sas/custom (or a directory
                        that path points to). The driver stages
                        <root>/macros (for %include) and <root>/Macro (the
                        autoexec_local.sas autocall path; credit_risk_scoring
                        reaches %lock only through autocall).
    GOLDEN_REAL_MACROS  side-effect macros to stage from legacy/sas/macros
                        instead of tools/sas_golden/stubs (any of:
                        sendmail lock export_xlsx). Default: none.
    GOLDEN_LOG_DIR      optional: one log per scenario is written here.
                        Logs carry host paths; never commit them.
    GOLDEN_OUT          output folder name per scenario (default golden).

  Per scenario the driver:
    1. creates a fresh data root under WORK (gs_<n>/...) with the
       directory layout of legacy/sas/config/autoexec_local.sas, points
       SAS_DATA_ROOT/SAS_REPO_ROOT at it and %includes autoexec_local.sas
       itself, so librefs (ORA_DW, TERA_DW, RAW_BANK, RAW_INS, STG_BANK,
       STG_INS, CURATED, REPORTS, ...), options and global macro variables
       are exactly the ones the programs expect;
    2. compiles legacy/sas/formats/*.sas into BANKING / INSURANCE of that
       root (a WORK copy without the sources' own libname lines, which
       point at /data/sas/formats);
    3. sets CURR_DT / PREV_YM to the scenario's run date / report month;
    4. reads every inputs/<libref>/<DATASET>.csv with an explicit INPUT
       statement generated by build_plan.py (dates DATE9. or ISO, empty
       field = missing; *_DESC companion columns are not SAS variables and
       are dropped). A CSV that is absent creates no dataset;
    5. copies legacy/sas/programs/<program>.sas, byte for byte, up to and
       including "%mend <program>;" into WORK and %includes that copy.
       The single self-invocation line after %mend (e.g.
       %claims_processing(proc_date=&CURR_DT);) is the only text not
       included: it would run with default parameters and, for programs
       that append/insert, a second explicit call would double the rows.
       The driver checks that this line is the only code after %mend;
    6. invokes the program macro once with the scenario's params;
    7. records SYSCC, leaves syntax-check mode (OBS=0) if the program
       entered it, and exports each target with the column order of
       baseline/sas/<TARGET>.csv: dates as YYYY-MM-DD, numbers unformatted
       (BEST32.), formats stripped from character columns, missing as an
       empty field, *_DESC columns as put(<var>, <format>.), wall-clock
       LOAD_TIMESTAMP / SCORE_TIMESTAMP left out, and any extra SAS column
       appended in PDV order. A target listed for the scenario but absent
       after the run is written header-only (kit convention).

  Stubs (tools/sas_golden/stubs, %macro <m> / parmbuff, log a NOTE only):
    sendmail     claims_processing, load_customer_accounts: sends mail.
                 The calls pass body=, which the real macro does not
                 declare, and it needs %seplist (not in the repo).
    lock         daily_transaction_processing, credit_risk_scoring (and
                 %included by load_customer_accounts): takes OS/SAS locks.
                 Calls are positional against a keyword-only macro and the
                 real macro needs %handle / %get_data_attr (not in repo).
    export_xlsx  monthly_regulatory_reporting: writes an XLSX workbook;
                 called with file=/sheet=, which it does not declare, and
                 it needs %export_dbms (not in the repo).
  None of the three writes to a dataset, so outputs do not depend on the
  stub. parmv and nobs are staged unmodified from legacy/sas/macros.
=====================================================================*/

%macro gs_env(name, default);
  %if %sysfunc(envlen(&name)) > 0 %then %sysget(&name);
  %else &default;
%mend gs_env;

%global GOLDEN_REPO GOLDEN_SAS_ROOT GOLDEN_REAL_MACROS GOLDEN_LOG_DIR GOLDEN_OUT
        gs_filter gs_n gs_skip gs_failed gs_prog gs_kit gs_id gs_root gs_outdir
        gs_curr_dt gs_prev_ym gs_call gs_syscc gs_empty;
%let GOLDEN_REPO        = %gs_env(GOLDEN_REPO, );
%let GOLDEN_SAS_ROOT    = %gs_env(GOLDEN_SAS_ROOT, /opt/sas/custom);
%let GOLDEN_REAL_MACROS = %gs_env(GOLDEN_REAL_MACROS, );
%let GOLDEN_LOG_DIR     = %gs_env(GOLDEN_LOG_DIR, );
%let GOLDEN_OUT         = %gs_env(GOLDEN_OUT, golden);
%let gs_filter          = %superq(sysparm);
%let gs_n               = 0;
%let gs_empty           = %sysfunc(pathname(work))/_gs_empty.sas;

/* ---------------------------------------------------------------- helpers */
%macro gs_mkdir(parent, child);
  %if not %sysfunc(fileexist(&parent/&child)) %then %do;
    %if %length(%sysfunc(dcreate(&child, &parent))) = 0 %then
      %put ERROR: [sas_golden] cannot create &parent/&child;
  %end;
%mend gs_mkdir;

%macro gs_copy(src, dst);
  %local rc fi fo;
  %let fi = _gsci; %let fo = _gsco;
  %let rc = %sysfunc(filename(fi, &src, , recfm=n));
  %let rc = %sysfunc(filename(fo, &dst, , recfm=n));
  %if %sysfunc(fcopy(&fi, &fo)) ne 0 %then
    %put ERROR: [sas_golden] cannot copy &src to &dst: %sysfunc(sysmsg());
  %let rc = %sysfunc(filename(fi));
  %let rc = %sysfunc(filename(fo));
%mend gs_copy;

%macro gs_clean(dir);
  /* remove CSVs / status from a previous run of this scenario */
  %local fr did i n names rc f2 mem;
  %let fr = _gsdir;
  %let rc = %sysfunc(filename(fr, &dir));
  %let did = %sysfunc(dopen(&fr));
  %if &did %then %do;
    %do i = 1 %to %sysfunc(dnum(&did));
      %let mem = %qsysfunc(dread(&did, &i));
      %if %qupcase(%qscan(&mem, -1, .)) = CSV or &mem = _status.txt %then %let names = &names &mem;
    %end;
    %let rc = %sysfunc(dclose(&did));
  %end;
  %let rc = %sysfunc(filename(fr));
  %do i = 1 %to %sysfunc(countw(&names, %str( )));
    %let f2 = _gsdel;
    %let rc = %sysfunc(filename(f2, &dir/%scan(&names, &i, %str( ))));
    %let rc = %sysfunc(fdelete(&f2));
    %let rc = %sysfunc(filename(f2));
  %end;
%mend gs_clean;

%macro gs_status(text=);
  data _null_;
    file "&gs_outdir/_status.txt" mod;
    put "&text";
  run;
%mend gs_status;

/* ------------------------------------------------- one-time setup checks */
%macro gs_setup;
  %local i m src;
  %if %length(&GOLDEN_REPO) = 0 or not %sysfunc(fileexist(&GOLDEN_REPO/legacy/sas/programs)) %then %do;
    %put ERROR: [sas_golden] set GOLDEN_REPO to the repository root.;
    %abort cancel;
  %end;
  %if not %sysfunc(fileexist(&GOLDEN_SAS_ROOT)) %then %do;
    %put ERROR: [sas_golden] &GOLDEN_SAS_ROOT does not exist (the programs %nrstr(%include) /opt/sas/custom/macros/*.sas).;
    %abort cancel;
  %end;
  %gs_mkdir(&GOLDEN_SAS_ROOT, macros)
  %gs_mkdir(&GOLDEN_SAS_ROOT, Macro)
  %do i = 1 %to 5;
    %let m = %scan(parmv nobs sendmail lock export_xlsx, &i, %str( ));
    %let src = &GOLDEN_REPO/tools/sas_golden/stubs/&m..sas;
    %if &m = parmv or &m = nobs %then %let src = &GOLDEN_REPO/legacy/sas/macros/&m..sas;
    %else %if %length(&GOLDEN_REAL_MACROS) %then %do;
      %if %sysfunc(indexw(%lowcase(&GOLDEN_REAL_MACROS), &m)) %then
        %let src = &GOLDEN_REPO/legacy/sas/macros/&m..sas;
    %end;
    %put NOTE: [sas_golden] staging &m from &src;
    %gs_copy(&src, &GOLDEN_SAS_ROOT/macros/&m..sas)
    %gs_copy(&src, &GOLDEN_SAS_ROOT/Macro/&m..sas)
  %end;
  data _null_; file "&gs_empty"; put "/* sas_golden: nothing to include */"; run;
%mend gs_setup;
%gs_setup

/* --------------------------------------------------------- plan macros */
%macro gs_begin(program=, kit=, id=, curr_dt=, prev_ym=, scendir=);
  %local want_prog want_id d;
  %let gs_skip = 0;
  %let gs_failed = ;
  %let gs_syscc = ;
  %let want_prog = %qscan(&gs_filter, 1, :);
  %let want_id = %qscan(&gs_filter, 2, :);
  %if %length(&want_prog) and %qupcase(&want_prog) ne %upcase(&program) %then %let gs_skip = 1;
  %if %length(&want_id) and %qupcase(&want_id) ne %upcase(&id) %then %let gs_skip = 1;
  filename gsauto "&gs_empty";
  filename gsfmt "&gs_empty";
  filename gsprg "&gs_empty";
  %if &gs_skip %then %return;

  %let gs_n = %eval(&gs_n + 1);
  %let gs_prog = &program;
  %let gs_kit = &kit;
  %let gs_id = &id;
  %let gs_curr_dt = &curr_dt;
  %let gs_prev_ym = &prev_ym;
  options obs=max replace nosyntaxcheck;
  %let syscc = 0;
  proc datasets lib=work kill memtype=(data view) nolist; quit;
  %if %length(&GOLDEN_LOG_DIR) %then %do;
    proc printto log="&GOLDEN_LOG_DIR/&program.__&id..log" new; run;
  %end;
  %put NOTE: [sas_golden] ===== scenario &gs_n: &program / &id =====;

  /* fresh data root with the autoexec_local.sas layout */
  %let gs_root = %sysfunc(pathname(work))/gs_&gs_n;
  %gs_mkdir(%sysfunc(pathname(work)), gs_&gs_n)
  %do d = 1 %to 9;
    %gs_mkdir(&gs_root, %scan(raw staging curated reports archive formats oracle_dw teradata_dw logs, &d, %str( )))
  %end;
  %gs_mkdir(&gs_root/raw, banking)
  %gs_mkdir(&gs_root/raw, insurance)
  %gs_mkdir(&gs_root/staging, banking)
  %gs_mkdir(&gs_root/staging, insurance)
  %gs_mkdir(&gs_root/reports, output)
  %gs_mkdir(&gs_root/formats, banking)
  %gs_mkdir(&gs_root/formats, insurance)
  %gs_mkdir(&gs_root/formats, common)

  %let gs_outdir = &GOLDEN_REPO/&scendir/&GOLDEN_OUT;
  %gs_mkdir(&GOLDEN_REPO/&scendir, &GOLDEN_OUT)
  %gs_clean(&gs_outdir)
  data _null_;
    file "&gs_outdir/_status.txt";
    put "program=&program" / "scenario=&id" / "curr_dt=&curr_dt" / "prev_ym=&prev_ym"
        / "provisional_until_reviewed=Y";
  run;

  options set=SAS_DATA_ROOT "&gs_root";
  options set=SAS_REPO_ROOT "&GOLDEN_SAS_ROOT";
  filename gsauto "&GOLDEN_REPO/legacy/sas/config/autoexec_local.sas";
  /* The format sources start with libname BANKING/INSURANCE "/data/sas/formats/...", which would
     re-point the librefs away from this scenario's root. Compile a WORK copy without those two lines. */
  %global gs_fmt_drops;
  data _null_;
    length src $512;
    infile "&GOLDEN_REPO/legacy/sas/formats/banking_formats.sas" lrecl=32767 end=eof1;
    file "%sysfunc(pathname(work))/_gs_formats.sas" lrecl=32767;
    retain drops 0 re;
    if _n_ = 1 then re = prxparse('/^\s*libname\s+(BANKING|INSURANCE)\s/i');
    do while (not eof1);
      input;
      if prxmatch(re, _infile_) then drops + 1; else put _infile_;
    end;
    src = "&GOLDEN_REPO/legacy/sas/formats/insurance_formats.sas";
    infile dummy filevar=src lrecl=32767 end=eof2;
    do while (not eof2);
      input;
      if prxmatch(re, _infile_) then drops + 1; else put _infile_;
    end;
    call symputx('gs_fmt_drops', drops, 'G');
    stop;
  run;
  %if &gs_fmt_drops ne 2 %then %let gs_failed = expected one libname line per format source, found &gs_fmt_drops;
  filename gsfmt "%sysfunc(pathname(work))/_gs_formats.sas" lrecl=32767;
%mend gs_begin;

%macro gs_params();
  %if &gs_skip %then %return;
  %let CURR_DT = &gs_curr_dt;
  %let PREV_YM = &gs_prev_ym;
  %put NOTE: [sas_golden] CURR_DT=&CURR_DT PREV_YM=&PREV_YM;
  %if &syscc > 4 %then %let gs_failed = setup(syscc=&syscc);
%mend gs_params;

%macro gs_input(lib=, ds=, csv=, spec=, fmt=, drop=);
  %local dsopt;
  %if &gs_skip or %length(&gs_failed) %then %return;
  %if not %sysfunc(fileexist(&GOLDEN_REPO/&csv)) %then %do;
    %let gs_failed = missing input &csv;
    %return;
  %end;
  %if %length(&drop) %then %let dsopt = (drop=&drop);
  data &lib..&ds&dsopt;
    infile "&GOLDEN_REPO/&csv" dsd dlm=',' firstobs=2 truncover lrecl=32767 termstr=lf encoding="utf-8";
    input @;
    if _infile_ = '' then delete;
    input &spec;
    %if %length(&fmt) %then %do; format &fmt; %end;
  run;
  %if &syscc > 4 %then %let gs_failed = load of &lib..&ds (syscc=&syscc);
%mend gs_input;

%macro gs_prepare(call=);
  %if &gs_skip %then %return;
  %if %length(&gs_failed) %then %do;
    %put ERROR: [sas_golden] &gs_prog / &gs_id not run: &gs_failed;
    %return;
  %end;
  %global gs_mend gs_trail gs_trail_call;
  data _null_;
    infile "&GOLDEN_REPO/legacy/sas/programs/&gs_prog..sas" lrecl=32767 end=eof;
    file "%sysfunc(pathname(work))/_gs_program.sas" lrecl=32767;
    retain after 0 ntrail 0 ncall 0 re;
    if _n_ = 1 then re = prxparse(cats('/^\s*', byte(37), 'mend\s+', "&gs_prog", '\s*;/i'));
    input;
    if not after then do;
      put _infile_;
      if prxmatch(re, _infile_) then after = 1;
    end;
    else if left(_infile_) ne '' and not (left(_infile_) =: '/*') then do;
      ntrail + 1;
      if upcase(left(_infile_)) =: upcase(cats(byte(37), "&gs_prog", '(')) then ncall + 1;
    end;
    if eof then do;
      call symputx('gs_mend', after, 'G');
      call symputx('gs_trail', ntrail, 'G');
      call symputx('gs_trail_call', ncall, 'G');
    end;
  run;
  %if &gs_mend ne 1 or &gs_trail ne 1 or &gs_trail_call ne 1 %then %do;
    %let gs_failed = unexpected program layout after the macro end statement (mend=&gs_mend trailing=&gs_trail);
    %put ERROR: [sas_golden] &gs_failed;
    %return;
  %end;
  filename gsprg "%sysfunc(pathname(work))/_gs_program.sas" lrecl=32767;
  %let gs_call = %superq(call);
  options obs=max replace nosyntaxcheck;
  %let syscc = 0;
%mend gs_prepare;

%macro gs_invoke();
  %if &gs_skip or %length(&gs_failed) %then %return;
  %put NOTE: [sas_golden] invoking %superq(gs_call);
  %unquote(&gs_call)
%mend gs_invoke;

%macro gs_after();
  %if &gs_skip %then %return;
  /* capture SYSCC, then leave batch syntax-check mode so exports run */
  options obs=max replace nosyntaxcheck;
  data _null_; call symputx('gs_syscc', symget('syscc'), 'G'); run;
%mend gs_after;

%macro gs_export(lib=, ds=, listed=1, cols=, datecols=, desc=);
  %local dsid i n c vn vt fmt sel expr d base dfmt extras nv;
  %if &gs_skip %then %return;
  %if %length(&gs_failed) %then %do;
    %gs_status(text=%str(&ds exists=? nobs=? note=not run: &gs_failed))
    %return;
  %end;
  %let syscc = 0;
  %if not %sysfunc(exist(&lib..&ds)) %then %do;
    %gs_status(text=%str(&ds exists=N nobs=0))
    %if &listed %then %do;
      data _null_;
        file "&gs_outdir/&ds..csv";
        put "%sysfunc(translate(&cols, %str(,), %str( )))";
      run;
    %end;
    %return;
  %end;

  %let dsid = %sysfunc(open(&lib..&ds));
  %let n = %sysfunc(attrn(&dsid, nlobs));
  /* planned columns, then any extra SAS column (PDV order) */
  %let nv = %sysfunc(attrn(&dsid, nvars));
  %do i = 1 %to &nv;
    %let c = %upcase(%sysfunc(varname(&dsid, &i)));
    %if not %sysfunc(indexw(&cols, &c)) and &c ne LOAD_TIMESTAMP and &c ne SCORE_TIMESTAMP %then
      %let extras = &extras &c;
  %end;
  %do i = 1 %to %sysfunc(countw(&cols &extras, %str( )));
    %let c = %scan(&cols &extras, &i, %str( ));
    %let vn = %sysfunc(varnum(&dsid, &c));
    %let expr = ;
    %if &vn = 0 %then %do;
      /* *_DESC companion: put(<var>, <format>.) */
      %do d = 1 %to %sysfunc(countw(&desc, %str( )));
        %if %scan(%scan(&desc, &d, %str( )), 1, :) = &c %then %do;
          %let base = %scan(%scan(&desc, &d, %str( )), 2, :);
          %let dfmt = %scan(%scan(&desc, &d, %str( )), 3, :);
          %if %sysfunc(varnum(&dsid, &base)) %then
            %let expr = strip(put(&base, &dfmt)) as &c length=200;
        %end;
      %end;
      /* a column SAS did not produce is left out, so parity_diff reports it */
    %end;
    %else %do;
      %let vt = %sysfunc(vartype(&dsid, &vn));
      /* format name without width/decimals: DATE9. -> DATE, E8601DA10. -> E8601DA */
      %let fmt = %upcase(%sysfunc(varfmt(&dsid, &vn)));
      %if %length(&fmt) %then %let fmt = %sysfunc(prxchange(%str(s/\d*\.\d*$//), 1, &fmt));
      %else %let fmt = NONE;
      %if &vt = C %then
        %let expr = &c as &c format=$%sysfunc(varlen(&dsid, &vn)).;
      %else %if %sysfunc(indexw(DATETIME E8601DT DATEAMPM, &fmt)) %then
        %let expr = case when missing(&c) then '' else translate(put(&c, e8601dt19.), ' ', 'T') end as &c length=19;
      %else %if %sysfunc(indexw(&datecols, &c)) or %sysfunc(indexw(DATE YYMMDD YYMMDDN MMDDYY DDMMYY E8601DA B8601DA WORDDATE MONYY, &fmt)) %then
        %let expr = case when missing(&c) then '' else put(&c, yymmdd10.) end as &c length=10;
      %else
        %let expr = case when missing(&c) then '' else strip(put(&c, best32.)) end as &c length=32;
    %end;
    %if %length(&expr) %then %do;
      %if %length(&sel) %then %let sel = &sel, &expr;
      %else %let sel = &expr;
    %end;
  %end;
  %let dsid = %sysfunc(close(&dsid));

  proc sql noprint;
    create view work._gs_out as select &sel from &lib..&ds;
  quit;
  proc export data=work._gs_out outfile="&gs_outdir/&ds..csv" dbms=csv replace;
    putnames=yes;
  run;
  proc sql noprint; drop view work._gs_out; quit;
  %if &syscc > 4 %then %gs_status(text=%str(&ds exists=Y nobs=&n note=EXPORT FAILED syscc=&syscc));
  %else %gs_status(text=%str(&ds exists=Y nobs=&n));
%mend gs_export;

%macro gs_end();
  %if &gs_skip %then %return;
  %if %length(&gs_failed) %then %gs_status(text=%str(result=NOT_RUN reason=&gs_failed));
  %else %gs_status(text=%str(program_syscc=&gs_syscc));
  %put NOTE: [sas_golden] ===== done: &gs_prog / &gs_id (program SYSCC=&gs_syscc) =====;
  %if %length(&GOLDEN_LOG_DIR) %then %do;
    proc printto; run;
  %end;
  proc datasets lib=work kill memtype=(data view) nolist; quit;
  options obs=max replace nosyntaxcheck;
  %let syscc = 0;
%mend gs_end;

/* ------------------------------------------------------------- run plan */
filename gsplan "&GOLDEN_REPO/tools/sas_golden/golden_plan.sas" lrecl=32767;
%include gsplan;
%put NOTE: [sas_golden] scenarios run in this session: &gs_n (filter: %superq(gs_filter));
